		qcom,spmi@c42d000 {
			compatible = "qcom,spmi-pmic-arb";
			reg = <0xc42d000 0x4000 0xc400000 0x3000 0xc500000 0x400000 0xc440000 0x80000 0xc4c0000 0x10000>;
			reg-names = "cnfg\0core\0chnls\0obsrvr\0intr";
			interrupts-extended = <0x26 0x01 0x04>;
			interrupt-names = "periph_irq";
			interrupt-controller;
			#interrupt-cells = <0x04>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			cell-index = <0x00>;
			qcom,channel = <0x00>;
			qcom,ee = <0x00>;
			qcom,bus-id = <0x00>;
			phandle = <0x87>;

			qcom,pm8010@c {
				compatible = "qcom,spmi-pmic";
				reg = <0x0c 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x6af>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pm8010_m";
				};

				pm8010m-temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x0c 0x24 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x653>;
				};
			};

			qcom,pm8010@d {
				compatible = "qcom,spmi-pmic";
				reg = <0x0d 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x6b0>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pm8010_n";
				};

				pm8010n-temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x0d 0x24 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x654>;
				};
			};

			qcom,pm8550@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pm8550";
				};

				pm8550-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x01 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x655 0x103>;
					io-channel-names = "thermal";
					phandle = <0x658>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm8550-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x68e>;

					key_vol_up {

						key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x68d>;
						};
					};

					anti_burn_mos_ctrl {

						anti_burn_mos_ctrl_default {
							pins = "gpio9";
							function = "normal";
							output-enable;
							power-source = <0x00>;
							phandle = <0x693>;
						};
					};

					display_therm {

						display_therm_default {
							pins = "gpio2";
							bias-high-impedance;
							phandle = <0x673>;
						};
					};

					conn_therm2 {

						conn_therm2_default {
							pins = "gpio4";
							bias-high-impedance;
							phandle = <0x670>;
						};
					};

					pa_therm1 {

						pa_therm1_default {
							pins = "gpio3";
							bias-high-impedance;
							phandle = <0x66f>;
						};
					};

					display_panel_avdd_default {
						phandle = <0x7ac>;
						qcom,drive-strength = <0x03>;
						power-source = <0x01>;
						bias-disable;
						output-enable;
						input-disable;
						function = "normal";
						pins = "gpio11";
					};
				};

				led-controller {
					compatible = "qcom,pm8350c-pwm";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
					nvmem = <0x656 0x657>;
					nvmem-names = "lpg_chan_sdam\0lut_sdam";

					led@1 {
						reg = <0x01>;
						color = <0x01>;
						label = "red";
					};

					led@2 {
						reg = <0x02>;
						color = <0x02>;
						label = "green";
					};

					led@3 {
						reg = <0x03>;
						color = <0x03>;
						label = "blue";
					};
				};

				bcl@4700 {
					compatible = "qcom,pm8550-bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x01 0x47 0x00 0x00 0x01 0x47 0x01 0x00 0x01 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x659>;
				};

				qcom,flash_led@ee00 {
					compatible = "qcom,qti-pm8350c-flash-led";
					reg = <0xee00>;
					interrupts = <0x01 0xee 0x00 0x01 0x01 0xee 0x03 0x01 0x01 0xee 0x04 0x01>;
					interrupt-names = "led-fault-irq\0all-ramp-down-done-irq\0all-ramp-up-done-irq";
					qcom,thermal-derate-current = <0xc8 0x1f4>;
					status = "ok";
					phandle = <0x6b1>;

					qcom,flash_0 {
						xiaomi,max-duration-ms = <0x12c>;
						label = "flash";
						qcom,led-name = "led:flash_0";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "flash0_trigger";
						qcom,id = <0x00>;
						qcom,duration-ms = <0x12c>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x6b2>;
					};

					qcom,flash_1 {
						label = "flash";
						qcom,led-name = "led:flash_1";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash1_trigger";
						qcom,id = <0x01>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x6b3>;
					};

					qcom,flash_2 {
						label = "flash";
						qcom,led-name = "led:flash_2";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash2_trigger";
						qcom,id = <0x02>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x6b4>;
					};

					qcom,flash_3 {
