			lpass-cdc {
				phandle = <0x575>;
				clocks = <0x56c 0x00 0x56d 0x00>;
				clock-names = "lpass_core_hw_vote\0lpass_audio_hw_vote";
				compatible = "qcom,lpass-cdc";
				#size-cells = <0x01>;
				#address-cells = <0x01>;
