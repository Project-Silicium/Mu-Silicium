		spf_core_platform: spf_core_platform {
			phandle = <0x5b4>;
			compatible = "qcom,spf-core-platform";

			msm_audio_ion: qcom,msm-audio-ion {
				phandle = <0x5b5>;
				dma-coherent;
				qcom,smmu-sid-mask = <0x00 0x0f>;
				qcom,iommu-dma-addr-pool = <0x10000000 0x10000000>;
				iommus = <0x5b 0x1801 0x00>;
				qcom,smmu-enabled;
				qcom,smmu-version = <0x02>;
				compatible = "qcom,msm-audio-ion";
			};

			msm_audio_ion_cma: qcom,msm-audio-ion-cma {
				phandle = <0x5b6>;
				compatible = "qcom,msm-audio-ion-cma";
			};

			lpi_tlmm: lpi_pinctrl@3440000 {
				phandle = <0x5b7>;
				clocks = <0x545 0x00 0x546 0x00>;
				clock-names = "lpass_core_hw_vote", "lpass_audio_hw_vote";
				qcom,lpi-slew-offset-tbl = <0x00 0x02 0x04 0x08 0x0a 0x0c 0x00 0x00 0x00 0x00 0x10 0x12 0x00 0x00 0x06 0x14 0x16 0x00 0x00 0x00 0x00 0x00 0x00>;
				qcom,lpi-offset-tbl = <0x00 0x1000 0x2000 0x3000 0x4000 0x5000 0x6000 0x7000 0x8000 0x9000 0xa000 0xb000 0xc000 0xd000 0xe000 0xf000 0x10000 0x11000 0x12000 0x13000 0x14000 0x15000 0x16000>;
				#gpio-cells = <0x02>;
				gpio-controller;
				qcom,gpios-count = <0x17>;
				qcom,slew-reg = <0x34da000 0x00>;
				reg = <0x3440000 0x00>;
				compatible = "qcom,lpi-pinctrl";

				quat_mi2s_sck {

					quat_mi2s_sck_sleep {
						phandle = <0x7a1>;

						mux {
							function = "func2";
							pins = "gpio0";
						};

						config {
							input-enable;
							bias-pull-down;
							drive-strength = <0x02>;
							pins = "gpio0";
						};
					};

					quat_mi2s_sck_active {
						phandle = <0x7a2>;

						mux {
							function = "func2";
							pins = "gpio0";
						};

						config {
							output-high;
							bias-disable;
							drive-strength = <0x08>;
							pins = "gpio0";
						};
					};
				};

				quat_mi2s_ws {

					quat_mi2s_ws_sleep {
						phandle = <0x7a3>;

						mux {
							function = "func2";
							pins = "gpio1";
						};

						config {
							input-enable;
							bias-pull-down;
							drive-strength = <0x02>;
							pins = "gpio1";
						};
					};

					quat_mi2s_ws_active {
						phandle = <0x7a4>;

						mux {
							function = "func2";
							pins = "gpio1";
						};

						config {
							output-high;
							bias-disable;
							drive-strength = <0x08>;
							pins = "gpio1";
						};
					};
				};

				quat_mi2s_sd0 {

					quat_mi2s_sd0_sleep {
						phandle = <0x7a5>;

						mux {
							function = "func2";
							pins = "gpio2";
						};

						config {
							input-enable;
							bias-pull-down;
							drive-strength = <0x02>;
							pins = "gpio2";
						};
					};

					quat_mi2s_sd0_active {
						phandle = <0x7a6>;

						mux {
							function = "func2";
							pins = "gpio2";
						};

						config {
							output-high;
							bias-disable;
							drive-strength = <0x08>;
							pins = "gpio2";
						};
