		psci {
			compatible = "arm,psci-1.0";
			method = "smc";

			CPU_PD0: cpu-pd0 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1d>;
				phandle = <0x05>;
			};

			CPU_PD1: cpu-pd1 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1d>;
				phandle = <0x08>;
			};

			CPU_PD2: cpu-pd2 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1d>;
				phandle = <0x0a>;
			};

			CPU_PD3: cpu-pd3 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1d>;
				phandle = <0x0b>;
			};

			CPU_PD4: cpu-pd4 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1d>;
				phandle = <0x0e>;
			};

			CPU_PD5: cpu-pd5 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1d>;
				phandle = <0x10>;
			};

			CPU_PD6: cpu-pd6 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1d>;
				phandle = <0x12>;
			};

			CPU_PD7: cpu-pd7 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1d>;
				phandle = <0x14>;
			};

			CLUSTER_PD: cluster-pd {
				#power-domain-cells = <0x00>;
				domain-idle-states = <0x38 0x39>;
				phandle = <0x1d>;
