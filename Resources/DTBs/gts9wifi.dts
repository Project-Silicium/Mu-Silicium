						iommus = <0x35 0x1961 0x00 0x35 0xc01 0x20 0x35 0x19c1 0x10>;
						dma-coherent;
					};

					compute-cb@2 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x02>;
						iommus = <0x35 0x1962 0x00 0x35 0xc02 0x20 0x35 0x19c2 0x10>;
						dma-coherent;
					};

					compute-cb@3 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x03>;
						iommus = <0x35 0x1963 0x00 0x35 0xc03 0x20 0x35 0x19c3 0x10>;
						dma-coherent;
					};

					compute-cb@4 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x04>;
						iommus = <0x35 0x1964 0x00 0x35 0xc04 0x20 0x35 0x19c4 0x10>;
						dma-coherent;
					};

					compute-cb@5 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x05>;
						iommus = <0x35 0x1965 0x00 0x35 0xc05 0x20 0x35 0x19c5 0x10>;
						dma-coherent;
					};

					compute-cb@6 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x06>;
						iommus = <0x35 0x1966 0x00 0x35 0xc06 0x20 0x35 0x19c6 0x10>;
						dma-coherent;
					};

					compute-cb@7 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x07>;
