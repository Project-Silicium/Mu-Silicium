	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x08 0x00 0x01 0x0e 0x08 0x00 0x01 0x0b 0x08 0x00 0x01 0x0a 0x08 0x00>;
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <0x134>;
		nvmem-cell-names = "reboot-mode";
		mode-recovery = <0x01>;
		mode-bootloader = <0x02>;
	};

	aliases {
		serial0 = "/soc@0/geniqup@ac0000/serial@a9c000";
		mmc1 = "/soc@0/mmc@8804000";
	};

	sec-kernel-log {
		compatible = "samsung,gts9wifi-sec-kernel-log";
		memory-region = <0x135>;
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x11a>;
	};

	wcn6855-pmu {
		compatible = "qcom,wcn6855-pmu";
		pinctrl-names = "default";
		pinctrl-0 = <0x136 0x137 0x138>;
		wlan-enable-gpios = <0x6b 0x50 0x00>;
		bt-enable-gpios = <0x6b 0x51 0x00>;
		swctrl-gpios = <0x6b 0x52 0x00>;
		xo-clk-gpios = <0x6b 0xcc 0x00>;
		qcom,qmp = <0xb1>;
		qcom,wlan-pdc-init = "{class: wlan_pdc, ss: rf, res: s4e.v, upval: 966}", "{class: wlan_pdc, ss: rf, res: s4e.v, dwnval: 615}", "{class: wlan_pdc, ss: rf, res: s4g.v, upval: 1350}", "{class: wlan_pdc, ss: rf, res: s4g.v, dwnval: 945}", "{class: wlan_pdc, ss: rf, res: s6g.v, upval: 1900}", "{class: wlan_pdc, ss: rf, res: s6g.v, dwnval: 1825}", "{class: wlan_pdc, ss: rf, res: s2g.m, enable: 1}", "{class: wlan_pdc, ss: rf, res: s2g.v, enable: 1}", "{class: wlan_pdc, ss: rf, res: s2g.v, upval: 1012}", "{class: wlan_pdc, ss: rf, res: s2g.v, dwnval: 800}", "{class: wlan_pdc, ss: bb, res: pdc, enable: 0}";
		vddio-supply = <0x94>;
		vddaon-supply = <0x139>;
		vddpmu-supply = <0x13a>;
		vddpmumx-supply = <0x13a>;
		vddpmucx-supply = <0x13a>;
		vddrfa0p95-supply = <0x11b>;
		vddrfa1p3-supply = <0x13b>;
		vddrfa1p9-supply = <0x13c>;
		vddpcie1p3-supply = <0x13b>;
		vddpcie1p9-supply = <0x13c>;

		regulators {

			ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn_0p8";
				phandle = <0x55>;
			};

			ldo1 {
				regulator-name = "vreg_pmu_aon_0p8";
				phandle = <0x56>;
			};

			ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
				phandle = <0x57>;
			};

			ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p8";
				phandle = <0x58>;
			};

			ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p8";
				phandle = <0x59>;
			};

			ldo5 {
				regulator-name = "vreg_pmu_pcie_1p8";
				phandle = <0xa1>;
			};

			ldo6 {
				regulator-name = "vreg_pmu_pcie_0p9";
				phandle = <0xa0>;
			};

			ldo7 {
				regulator-name = "vreg_pmu_rfa_0p8";
				phandle = <0x5a>;
			};

			ldo8 {
				regulator-name = "vreg_pmu_rfa_1p2";
				phandle = <0x5b>;
			};

			ldo9 {
				regulator-name = "vreg_pmu_rfa_1p7";
				phandle = <0x5c>;
			};
		};
	};

	regulator-speaker-vdd {
		compatible = "regulator-fixed";
		regulator-name = "speaker_vdd";
		gpio = <0x6b 0x13 0x00>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x6c>;
	};

	rear-cam-vio-regulator {
		compatible = "regulator-fixed";
		regulator-name = "rear_cam_vio";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <0xed>;
		gpio = <0x6b 0x0f 0x00>;
		enable-active-high;
		phandle = <0xe3>;
	};

	battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <0x7c8300>;
		voltage-max-design-microvolt = <0x43bfc0>;
		voltage-min-design-microvolt = <0x33e140>;
		phandle = <0x71>;
	};

	usb-c-sbu-mux {
		compatible = "gpio-sbu-mux";
		enable-gpios = <0x6b 0xb7 0x01>;
		select-gpios = <0x6b 0xb4 0x00>;
		mode-switch;
		orientation-switch;

		port {

			endpoint {
				remote-endpoint = <0x13d>;
				phandle = <0x79>;
			};
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0x13e 0x13f>;

		key-volume-up {
			label = "Volume Up";
			linux,code = <0x73>;
			gpios = <0xd1 0x06 0x01>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};

		switch-lid {
			label = "Book Cover";
			linux,input-type = <0x05>;
			linux,code = <0x00>;
			gpios = <0x6b 0x6b 0x01>;
			debounce-interval = <0x32>;
			wakeup-source;
		};
	};

	sound {
		compatible = "qcom,sm8550-sndcard", "qcom,sm8450-sndcard";
		model = "Samsung-Galaxy-Tab-S9";
		pinctrl-names = "default";
		pinctrl-0 = <0x140 0x141 0x142 0x143>;

		speaker-playback-dai-link {
			link-name = "CS35L45 Speaker Playback";

			cpu {
				sound-dai = <0x144 0x10>;
			};

			codec {
				sound-dai = <0x145 0x00 0x146 0x00 0x147 0x00 0x148 0x00>;
			};

			platform {
				sound-dai = <0x149>;
			};
		};

		va-capture-dai-link {
			link-name = "Internal DMIC Capture";

			cpu {
				sound-dai = <0x144 0x6e>;
			};

			codec {
				sound-dai = <0xc1 0x00>;
			};

			platform {
				sound-dai = <0x149>;
			};
		};
	};

	regulator-display-avdd {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_avdd";
		regulator-min-microvolt = <0x53ec60>;
		regulator-max-microvolt = <0x53ec60>;
		gpio = <0xd1 0x0b 0x00>;
		enable-active-high;
		regulator-boot-on;
		phandle = <0x107>;
	};

	regulator-panel-ldo {
		compatible = "regulator-fixed";
		regulator-name = "panel_ldo_en";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		gpio = <0x6b 0xbb 0x00>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};
};
