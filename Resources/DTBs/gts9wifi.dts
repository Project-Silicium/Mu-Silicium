/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Samsung Galaxy Tab S9 Wi-Fi";
	compatible = "qcom,kalama-mtp", "qcom,kalama", "qcom,mtp", "samsung,gts9wifi", "qcom,sm8550";
	qcom,msm-id = <0x218 0x20000 0x207 0x20000 0x207 0x10000 0x218 0x10000>;
	qcom,board-id = <0x10008 0x04>;
	chassis-type = "tablet";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x493e000>;
			phandle = <0x118>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			phandle = <0x30>;
		};

		bi-tcxo-div2-clk {
			#clock-cells = <0x00>;
			compatible = "fixed-factor-clock";
			clocks = <0x02 0x00>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0x2f>;
		};

		bi-tcxo-ao-div2-clk {
			#clock-cells = <0x00>;
			compatible = "fixed-factor-clock";
			clocks = <0x02 0x01>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0xf8>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x00 0x00>;
			clocks = <0x03 0x00>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			power-domains = <0x05>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x00>;
			capacity-dmips-mhz = <0x146>;
			dynamic-power-coefficient = <0xfb>;
			#cooling-cells = <0x02>;
			phandle = <0x15>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x04>;

				l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					cache-unified;
					phandle = <0x06>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x00 0x100>;
			clocks = <0x03 0x00>;
			enable-method = "psci";
			next-level-cache = <0x07>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x00>;
			capacity-dmips-mhz = <0x146>;
			dynamic-power-coefficient = <0xfb>;
			#cooling-cells = <0x02>;
			phandle = <0x16>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x07>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a510";
			reg = <0x00 0x200>;
			clocks = <0x03 0x00>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			power-domains = <0x0a>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x00>;
			capacity-dmips-mhz = <0x146>;
			dynamic-power-coefficient = <0xfb>;
			#cooling-cells = <0x02>;
			phandle = <0x17>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x09>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x00 0x300>;
			clocks = <0x03 0x01>;
			enable-method = "psci";
			next-level-cache = <0x0b>;
			power-domains = <0x0c>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x01>;
			capacity-dmips-mhz = <0x2b5>;
			dynamic-power-coefficient = <0x1bf>;
			#cooling-cells = <0x02>;
			phandle = <0x18>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0b>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a715";
			reg = <0x00 0x400>;
			clocks = <0x03 0x01>;
			enable-method = "psci";
			next-level-cache = <0x0d>;
			power-domains = <0x0e>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x01>;
			capacity-dmips-mhz = <0x2b5>;
			dynamic-power-coefficient = <0x1bf>;
			#cooling-cells = <0x02>;
			phandle = <0x19>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0d>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a710";
			reg = <0x00 0x500>;
			clocks = <0x03 0x01>;
			enable-method = "psci";
			next-level-cache = <0x0f>;
			power-domains = <0x10>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x01>;
			capacity-dmips-mhz = <0x2b5>;
			dynamic-power-coefficient = <0x1bf>;
			#cooling-cells = <0x02>;
			phandle = <0x1a>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x0f>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a710";
			reg = <0x00 0x600>;
			clocks = <0x03 0x01>;
			enable-method = "psci";
			next-level-cache = <0x11>;
			power-domains = <0x12>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x01>;
			capacity-dmips-mhz = <0x2b5>;
			dynamic-power-coefficient = <0x1bf>;
			#cooling-cells = <0x02>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x11>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-x3";
			reg = <0x00 0x700>;
			clocks = <0x03 0x02>;
			enable-method = "psci";
			next-level-cache = <0x13>;
			power-domains = <0x14>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x03 0x02>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x421>;
			#cooling-cells = <0x02>;
			phandle = <0x1c>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x06>;
				phandle = <0x13>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x15>;
				};

				core1 {
					cpu = <0x16>;
				};

				core2 {
					cpu = <0x17>;
				};

				core3 {
					cpu = <0x18>;
				};

				core4 {
					cpu = <0x19>;
				};

				core5 {
					cpu = <0x1a>;
				};

				core6 {
					cpu = <0x1b>;
				};

				core7 {
					cpu = <0x1c>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "silver-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x226>;
				exit-latency-us = <0x2ee>;
				min-residency-us = <0x1a2c>;
				local-timer-stop;
				phandle = <0x28>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "gold-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x258>;
				exit-latency-us = <0x514>;
				min-residency-us = <0x1fc8>;
				local-timer-stop;
				phandle = <0x29>;
			};

			cpu-sleep-2-0 {
				compatible = "arm,idle-state";
				idle-state-name = "goldplus-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x1f4>;
				exit-latency-us = <0x546>;
				min-residency-us = <0x1d38>;
				local-timer-stop;
				phandle = <0x2a>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41000044>;
				entry-latency-us = <0x2ee>;
				exit-latency-us = <0x92e>;
				min-residency-us = <0x23b8>;
				phandle = <0x2b>;
			};

			cluster-sleep-1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x4100c344>;
				entry-latency-us = <0xaf0>;
				exit-latency-us = <0x1130>;
				min-residency-us = <0x27a6>;
				phandle = <0x2c>;
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-sm8550", "qcom,scm";
			qcom,dload-mode = <0x1d 0x19000>;
			interconnects = <0x1e 0x02 0x07 0x1f 0x01 0x07>;
			interrupts = <0x00 0x3a2 0x01>;
		};
	};

	interconnect-0 {
		compatible = "qcom,sm8550-clk-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x20>;
		phandle = <0x38>;
	};

	interconnect-1 {
		compatible = "qcom,sm8550-mc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x20>;
		phandle = <0x1f>;
	};

	opp-table-qup100mhz {
		compatible = "operating-points-v2";
		phandle = <0x5e>;

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x21>;
		};

		opp-100000000 {
			opp-hz = <0x00 0x5f5e100>;
			required-opps = <0x22>;
		};
	};

	opp-table-qup120mhz {
		compatible = "operating-points-v2";
		phandle = <0x3d>;

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x21>;
		};

		opp-120000000 {
			opp-hz = <0x00 0x7270e00>;
			required-opps = <0x22>;
		};
	};

	opp-table-qup125mhz {
		compatible = "operating-points-v2";
		phandle = <0x54>;

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x21>;
		};

		opp-125000000 {
			opp-hz = <0x00 0x7735940>;
			required-opps = <0x22>;
		};
	};

	memory@a0000000 {
		device_type = "memory";
		reg = <0x00 0xa0000000 0x00 0x00>;
	};

	pmu-a510 {
		compatible = "arm,cortex-a510-pmu";
		interrupts = <0x01 0x07 0x08 0x23>;
	};

	pmu-a710 {
		compatible = "arm,cortex-a710-pmu";
		interrupts = <0x01 0x07 0x08 0x24>;
	};

	pmu-a715 {
		compatible = "arm,cortex-a715-pmu";
		interrupts = <0x01 0x07 0x08 0x25>;
	};

	pmu-x3 {
		compatible = "arm,cortex-x3-pmu";
		interrupts = <0x01 0x07 0x08 0x26>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x28>;
			phandle = <0x05>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x28>;
			phandle = <0x08>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x28>;
			phandle = <0x0a>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x29>;
			phandle = <0x0c>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x29>;
			phandle = <0x0e>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x29>;
			phandle = <0x10>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x29>;
			phandle = <0x12>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x2a>;
			phandle = <0x14>;
		};

		power-domain-cluster {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x2b 0x2c>;
			phandle = <0x27>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		hyp-region@80000000 {
			reg = <0x00 0x80000000 0x00 0xa00000>;
			no-map;
		};

		cpusys-vm-region@80a00000 {
			reg = <0x00 0x80a00000 0x00 0x400000>;
			no-map;
		};

		hyp-tags-region@80e00000 {
			reg = <0x00 0x80e00000 0x00 0x3d0000>;
			no-map;
		};

		xbl-sc-region@d8100000 {
			reg = <0x00 0xd8100000 0x00 0x40000>;
			no-map;
		};

		hyp-tags-reserved-region@811d0000 {
			reg = <0x00 0x811d0000 0x00 0x30000>;
			no-map;
		};

		xbl-dt-log-merged-region@81a00000 {
			reg = <0x00 0x81a00000 0x00 0x260000>;
			no-map;
		};

		aop-cmd-db-region@81c60000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x81c60000 0x00 0x20000>;
			no-map;
		};

		aop-config-merged-region@81c80000 {
			reg = <0x00 0x81c80000 0x00 0x74000>;
			no-map;
		};

		smem@81d00000 {
			compatible = "qcom,smem";
			reg = <0x00 0x81d00000 0x00 0x200000>;
			hwlocks = <0x2d 0x03>;
			no-map;
		};

		adsp-mhi-region@81f00000 {
			reg = <0x00 0x81f00000 0x00 0x20000>;
			no-map;
		};

		global-sync-region@82600000 {
			reg = <0x00 0x82600000 0x00 0x100000>;
			no-map;
		};

		tz-stat-region@82700000 {
			reg = <0x00 0x82700000 0x00 0x100000>;
			no-map;
		};

		cdsp-secure-heap-region@82800000 {
			reg = <0x00 0x82800000 0x00 0x4600000>;
			no-map;
		};

		mpss-region@8a800000 {
			reg = <0x00 0x8a800000 0x00 0x10800000>;
			no-map;
			phandle = <0xb7>;
		};

		q6-mpss-dtb-region@9b000000 {
			reg = <0x00 0x9b000000 0x00 0x80000>;
			no-map;
			phandle = <0xb8>;
		};

		ipa-fw-region@9b080000 {
			reg = <0x00 0x9b080000 0x00 0x10000>;
			no-map;
		};

		ipa-gsi-region@9b090000 {
			reg = <0x00 0x9b090000 0x00 0xa000>;
			no-map;
		};

		gpu-micro-code-region@9b09a000 {
			reg = <0x00 0x9b09a000 0x00 0x2000>;
			no-map;
			phandle = <0xaf>;
		};

		spss-region@9b100000 {
			reg = <0x00 0x9b100000 0x00 0x180000>;
			no-map;
		};

		spu-tz-shared-region@9b280000 {
			reg = <0x00 0x9b280000 0x00 0x60000>;
			no-map;
		};

		spu-modem-shared-region@9b2e0000 {
			reg = <0x00 0x9b2e0000 0x00 0x20000>;
			no-map;
		};

		camera-region@9b300000 {
			reg = <0x00 0x9b300000 0x00 0x800000>;
			no-map;
		};

		video-region@9bb00000 {
			reg = <0x00 0x9bb00000 0x00 0x700000>;
			no-map;
			phandle = <0xdc>;
		};

		cvp-region@9c200000 {
			reg = <0x00 0x9c200000 0x00 0x700000>;
			no-map;
		};

		cdsp-region@9c900000 {
			reg = <0x00 0x9c900000 0x00 0x2000000>;
			no-map;
			phandle = <0x120>;
		};

		q6-cdsp-dtb-region@9e900000 {
			reg = <0x00 0x9e900000 0x00 0x80000>;
			no-map;
			phandle = <0x121>;
		};

		q6-adsp-dtb-region@9e980000 {
			reg = <0x00 0x9e980000 0x00 0x80000>;
			no-map;
			phandle = <0xbe>;
		};

		rmtfs-region@d4a80000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x00 0xd4a80000 0x00 0x280000>;
			no-map;
			qcom,client-id = <0x01>;
			qcom,vmid = <0x0f>;
		};

		mpss-dsm-region@d4d00000 {
			reg = <0x00 0xd4d00000 0x00 0x3300000>;
			no-map;
			phandle = <0xb9>;
		};

		tz-reserved-region@d8000000 {
			reg = <0x00 0xd8000000 0x00 0x100000>;
			no-map;
		};

		cpucp-fw-region@d8140000 {
			reg = <0x00 0xd8140000 0x00 0x1c0000>;
			no-map;
		};

		qtee-region@d8300000 {
			reg = <0x00 0xd8300000 0x00 0x500000>;
			no-map;
		};

		ta-region@d8800000 {
			reg = <0x00 0xd8800000 0x00 0x8a00000>;
			no-map;
		};

		tz-tags-region@e1200000 {
			reg = <0x00 0xe1200000 0x00 0x2740000>;
			no-map;
		};

		hwfence-shbuf-region@e6440000 {
			reg = <0x00 0xe6440000 0x00 0x2dd000>;
			no-map;
		};

		trust-ui-vm-region@f3600000 {
			reg = <0x00 0xf3600000 0x00 0x4aee000>;
			no-map;
		};

		trust-ui-vm-dump-region@f80ee000 {
			reg = <0x00 0xf80ee000 0x00 0x1000>;
			no-map;
		};

		trust-ui-vm-qrt-region@f80ef000 {
			reg = <0x00 0xf80ef000 0x00 0x9000>;
			no-map;
		};

		trust-ui-vm-vblk0-ring-region@f80f8000 {
			reg = <0x00 0xf80f8000 0x00 0x4000>;
			no-map;
		};

		trust-ui-vm-vblk1-ring-region@f80fc000 {
			reg = <0x00 0xf80fc000 0x00 0x4000>;
			no-map;
		};

		trust-ui-vm-swiotlb-region@f8100000 {
			reg = <0x00 0xf8100000 0x00 0x100000>;
			no-map;
		};

		oem-vm-region@f8400000 {
			reg = <0x00 0xf8400000 0x00 0x4800000>;
			no-map;
		};

		oem-vm-vblk0-ring-region@fcc00000 {
			reg = <0x00 0xfcc00000 0x00 0x4000>;
			no-map;
		};

		oem-vm-swiotlb-region@fcc04000 {
			reg = <0x00 0xfcc04000 0x00 0x100000>;
			no-map;
		};

		hyp-ext-tags-region@fce00000 {
			reg = <0x00 0xfce00000 0x00 0x2900000>;
			no-map;
		};

		hyp-ext-reserved-region@ff700000 {
			reg = <0x00 0xff700000 0x00 0x100000>;
			no-map;
		};

		kaslr@b01ff000 {
			reg = <0x00 0xb01ff000 0x00 0x1000>;
			no-map;
		};

